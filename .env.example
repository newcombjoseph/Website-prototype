# Copy to .env for Docker Compose. Never commit real secrets.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_VALUE_AT_LEAST_50_CHARACTERS_LONG
DJANGO_ALLOWED_HOSTS=existing-store-hostname.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://existing-store-hostname.example
PUBLIC_ORIGIN=https://existing-store-hostname.example
APP_HOST=existing-store-hostname.example
TRUST_HTTPS_PROXY=true
PRIVATE_ACCESS_REQUIRED=true
PRIVATE_USERNAME=owner
# Generate with Django make_password using a password read with getpass.
PRIVATE_PASSWORD_HASH=REPLACE_WITH_A_DJANGO_PASSWORD_HASH
CHECKOUT_MODE=simulated
# Only sk_test_ or rk_test_ keys can be used. Never put keys in frontend code.
STRIPE_SECRET_KEY=

# AWS production: inject actual values securely; URL-encode database passwords.
APP_ENV=production
# Example hostname only. Use an RDS application role, not the master account.
DATABASE_URL=postgresql://APP_USER:ENCODED_PASSWORD@YOUR_DB.rds.amazonaws.com:5432/bonnets?sslmode=verify-full&sslrootcert=/run/rds/global-bundle.pem
AWS_STORAGE_BUCKET_NAME=YOUR_PRIVATE_PRODUCT_IMAGE_BUCKET
AWS_S3_REGION_NAME=us-east-1
# Use an EC2/ECS IAM role. Do not commit AWS access keys.
# Required only for stripe_test checkout; configure in secure environment settings.
STRIPE_WEBHOOK_SECRET=

# Absolute path on the AWS compute host to the verified public RDS CA bundle.
RDS_CA_BUNDLE_PATH=/absolute/path/to/global-bundle.pem
