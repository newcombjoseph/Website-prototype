# Copy to .env for Docker Compose. Never commit real secrets.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_VALUE_AT_LEAST_50_CHARACTERS_LONG
DJANGO_ALLOWED_HOSTS=existing-store-hostname.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://existing-store-hostname.example
PUBLIC_ORIGIN=https://existing-store-hostname.example
APP_HOST=existing-store-hostname.example
TRUST_HTTPS_PROXY=true
PRIVATE_ACCESS_REQUIRED=true
PRIVATE_USERNAME=owner
# Generate with Django make_password using a password read with getpass.
PRIVATE_PASSWORD_HASH=REPLACE_WITH_A_DJANGO_PASSWORD_HASH
CHECKOUT_MODE=simulated
# Only sk_test_ or rk_test_ keys can be used. Never put keys in frontend code.
STRIPE_SECRET_KEY=
